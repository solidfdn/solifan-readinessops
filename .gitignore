# ============================================================
# .gitignore — SOLIFAN ReadinessOps
# ============================================================

# Cortex Code internal state
.cortex/

# Environment and credentials
.env
.env.*
*.pem
*.p8
*.key
credentials*
connections.toml
config.toml

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local output and logs
*.log
output/
tmp/
temp/

# Local ReadinessOps validation and patch artifacts
/_audit/
/_backup/
/_final/
/_patches/
/READINESSOPS_CURRENT.zip
/streamlit_execute_debug.txt
/00_collect_readinessops_current_state_v2.ps1
/restore_legacy_streamlit.sql
/snowflake.yml
/snowflake.yml.before_*
/app/*.backup_*
/app/*.failed_*.py
/app/*.before_bool_fix_*
